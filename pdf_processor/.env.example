# AWS RDS PostgreSQL Settings - Replace with your actual credentials
POSTGRES_SERVER=your-rds-endpoint.region.rds.amazonaws.com
POSTGRES_USER=your_rds_user
POSTGRES_PASSWORD=your_rds_password
POSTGRES_DB=your_rds_database_name
POSTGRES_PORT=5432

# Redis Settings
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_BACKEND_URL=redis://redis:6379/1

# Celery Worker Settings
# Controls the number of concurrent worker processes (cores)
CELERY_WORKER_CONCURRENCY=4
